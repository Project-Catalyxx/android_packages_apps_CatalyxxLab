<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/user_interface_title">

    <!-- RisingOS's font picker, built into Settings (PersonalizationsManifest.xml) -->
    <Preference
        android:key="fonts"
        android:title="@string/fonts_title"
        app:keywords="@string/fonts_keywords"
        android:summary="@string/fonts_summary"
        android:icon="@drawable/ic_fonts">
        <intent
            android:targetPackage="com.android.settings"
            android:targetClass="com.android.settings.Settings$PersonalizationsFontActivity" />
    </Preference>
    <!-- RisingOS's QuickSwitch, built into Settings (PersonalizationsManifest.xml) -->
    <Preference
        android:key="home_app"
        android:title="@string/home_app_title"
        app:keywords="@string/home_app_keywords"
        android:summary="@string/home_app_summary"
        android:icon="@drawable/ic_home_app">
        <intent
            android:targetPackage="com.android.settings"
            android:targetClass="com.android.settings.Settings$PersonalizationsQuickSwitchActivity" />
    </Preference>
    <!-- Android's own blur setting, which Accessibility shows the other way round -->
    <org.catalyxx.lab.BlurEffectsPreference
        android:key="blur_effects"
        android:title="@string/blur_effects_title"
        app:keywords="@string/blur_effects_keywords"
        android:summary="@string/blur_effects_summary"
        android:icon="@drawable/ic_blur" />
    <!-- Catalyxx's system glass, on its own page; the summary says on or off -->
    <Preference
        android:key="glass"
        android:title="@string/glass_title"
        app:keywords="@string/glass_keywords"
        android:icon="@drawable/ic_glass"
        android:fragment="org.catalyxx.lab.GlassFragment" />
    <!-- Developer options' three animation scales, all on one slider -->
    <org.catalyxx.lab.AnimationSpeedPreference
        android:key="animation_speed"
        android:title="@string/animation_speed_title"
        app:keywords="@string/animation_speed_keywords"
        android:icon="@drawable/ic_animation" />
</PreferenceScreen>
