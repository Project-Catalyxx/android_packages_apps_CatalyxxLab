<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/status_bar_title">

    <!-- LineageOS's status bar options, which LineageParts shows (Settings lists the same page
         under System); opened as Settings' System row opens it, by its activity alias -->
    <Preference
        android:key="status_bar_options"
        android:title="@string/status_bar_options_title"
        app:keywords="@string/status_bar_options_keywords"
        android:summary="@string/status_bar_options_summary"
        android:icon="@drawable/ic_status_bar">
        <intent
            android:targetPackage="org.lineageos.lineageparts"
            android:targetClass="org.lineageos.lineageparts.statusbar.StatusBarSettings" />
    </Preference>
</PreferenceScreen>
