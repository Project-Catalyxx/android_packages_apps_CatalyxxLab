     A front page card: a rounded tile with a ripple. The mask gives the card
     its outline, so clipToOutline rounds whatever the card shows.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@android:color/system_accent1_300">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/lab_card_radius" />
        </shape>
    </item>
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/lab_card_color" />
            <corners android:radius="@dimen/lab_card_radius" />
        </shape>
    </item>
</ripple>
