# The Lab's pages and preferences are named only in res/xml: android:fragment
# and custom preference tags, which R8 doesn't follow. Without this it strips
# them and the Lab crashes with ClassNotFoundException when a page opens.
-keep class org.catalyxx.lab.** { *; }
