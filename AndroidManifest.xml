<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.catalyxx.lab">

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- The front page shows the wallpaper behind its clocks -->
    <uses-permission android:name="android.permission.READ_WALLPAPER_INTERNAL" />

    <application
        android:icon="@drawable/ic_lab"
        android:label="@string/lab_title"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <!-- The card on Settings' home screen. Settings picks up IA_SETTINGS
             activities of system apps (SettingsLib TileUtils). Homepage, no
             group key and order -125 put it on its own between the
             connectivity card (-130) and the personalize card (-120) in both
             top_level_settings.xml and top_level_settings_expressive.xml; the
             homepage has no tile placeholder, so the order is used as is. -->
        <activity
            android:name=".LabActivity"
            android:exported="true"
            android:label="@string/lab_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-125" />
            <!-- The card it shares with the device's own settings, which Catalyxx's
                 Settings puts between connectivity and personalize -->
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="top_level_extras_category" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/lab_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/lab_tagline" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_lab" />
            <meta-data
                android:name="com.android.settings.icon_color_scheme"
                android:value="purple" />
            <meta-data
                android:name="com.android.settings.profile"
                android:value="primary_profile_only" />
        </activity>
    </application>
</manifest>
